// TRACK.exe's icon and version information (r549: "QLC skal fjernes fra navne, logoer osv")
#include <winver.h>

IDI_ICON1 ICON "../branding/track.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,549,0
PRODUCTVERSION  1,0,549,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "F4MES"
            VALUE "FileDescription",  "TRACK"
            VALUE "FileVersion",      "1.0.549"
            VALUE "InternalName",     "TRACK"
            VALUE "LegalCopyright",   "Apache License 2.0"
            VALUE "OriginalFilename", "TRACK.exe"
            VALUE "ProductName",      "TRACK"
            VALUE "ProductVersion",   "1.0.549"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
