// track-app branch (r549, Tobias 11-04: "QLC skal fjernes fra navne, logoer osv"): this branch's
// program is TRACK - its icon and version information, so Windows never shows it as QLC+
#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "../trackbridge/branding/track.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,549,0
PRODUCTVERSION  1,0,549,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "F4MES"
            VALUE "FileDescription",  "TRACK"
            VALUE "FileVersion",      "1.0.549"
            VALUE "InternalName",     "TRACK-engine"
            VALUE "LegalCopyright",   "Apache License 2.0 - built on Q Light Controller Plus"
            VALUE "OriginalFilename", "TRACK-engine.exe"
            VALUE "ProductName",      "TRACK"
            VALUE "ProductVersion",   "1.0.549"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
